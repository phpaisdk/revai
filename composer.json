{
    "name": "aisdk/revai",
    "description": "Official RevAi provider for the PHP AI SDK.",
    "license": "MIT",
    "keywords": [
        "ai",
        "aisdk",
        "revai",
        "transcription",
        "speech-to-text"
    ],
    "homepage": "https://github.com/phpaisdk/revai",
    "support": {
        "issues": "https://github.com/phpaisdk/revai/issues",
        "source": "https://github.com/phpaisdk/revai"
    },
    "require": {
        "php": "^8.3",
        "aisdk/core": "^0.11.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^3.0 || ^4.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AiSdk\\": "src/Root/",
            "AiSdk\\RevAi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AiSdk\\RevAi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyze": "vendor/bin/phpstan analyze --memory-limit=512M",
        "test": "vendor/bin/pest",
        "test:all": [
            "@lint",
            "@analyze",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    }
}
